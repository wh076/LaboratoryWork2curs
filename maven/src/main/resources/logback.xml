<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Консольный аппендер -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss} %-5level %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Файл для сообщений чата -->
    <appender name="CHAT_FILE" class="ch.qos.logback.core.FileAppender">
        <file>chat_messages.log</file>
        <append>true</append>
        <encoder>
            <pattern>%date %-5level - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Файл для ошибок -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.FileAppender">
        <file>chat_errors.log</file>
        <append>true</append>
        <encoder>
            <pattern>%date %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Файл для общей информации сервера -->
    <appender name="SERVER_FILE" class="ch.qos.logback.core.FileAppender">
        <file>server.log</file>
        <append>true</append>
        <encoder>
            <pattern>%date %-5level - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Логгер для сообщений чата -->
    <logger name="chat" level="INFO" additivity="false">
        <appender-ref ref="CHAT_FILE" />
        <appender-ref ref="CONSOLE" />
    </logger>

    <!-- Логгер для ошибок -->
    <logger name="errors" level="ERROR" additivity="false">
        <appender-ref ref="ERROR_FILE" />
    </logger>

    <!-- Логгер для сервера -->
    <logger name="org.example.ChatServer" level="INFO">
        <appender-ref ref="SERVER_FILE" />
    </logger>

    <logger name="org.example.ClientHandler" level="INFO">
        <appender-ref ref="SERVER_FILE" />
    </logger>

    <!-- Корневой логгер -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
    </root>
</configuration>